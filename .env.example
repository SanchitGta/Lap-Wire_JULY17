# Slack app credentials — obtain from https://api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# CSRF state token for OAuth — minimum 32 random characters
SLACK_STATE_SECRET=

# Filesystem path to the SQLite database file
DATABASE_PATH=./data/lapwire.db

# HTTP port (defaults to 3000 if unset)
PORT=3000

# Public base URL used to construct install links in error messages
# Must start with https://
APP_URL=https://lapwire.example.com
